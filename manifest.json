{
  "manifest_version": 3,
  "name": "PRA · 个人研究助手",
  "version": "1.6.0",
  "description": "PRA · 个人研究助手：从网页内容生成研究 Prompt，并发送到 ChatGPT、Custom GPT 或 Plugin。",
  "permissions": ["contextMenus", "tabs", "storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "http://127.0.0.1/*", "http://localhost/*"],
    "js": ["chatgpt-content.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["http://127.0.0.1/*", "http://localhost/*"],
    "js": ["article-content.js"],
    "run_at": "document_idle"
  }]
}
